; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Vettura"
config/version="0.0.1"
run/main_scene="res://game/lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MCPRuntimeProbe="*uid://bsg12huaf1u5i"
GameSettings="*res://game/game_settings.gd"
I18n="*res://game/i18n/i18n.gd"
GameInput="*res://game/input/game_input.gd"
ModLibrary="*res://game/mod_library.gd"
RenderFX="*res://game/render/post_fx.gd"
DisplayPipeline="*res://game/render/display_pipeline.gd"
RenderQuality="*res://game/render/render_quality.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[filesystem]

import/blender/enabled=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; 桌面用 Forward+（SSAO/SSIL/SSR/体积雾/ACES 等完整后处理）；
; 移动端仍走 Mobile（见下一行的平台覆盖），不把桌面效果带进 APK。
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
; 各向异性过滤：黑白格终点线/路面标线这类高频贴图在移动时会出现
; 摩尔纹闪烁，mipmap 各向异性采样能显著改善（见 docs/godot.md）。
textures/default_filters/anisotropic_filtering_level=8

; 完整天空 + 环境光：不挂这条时 Godot 回落到深灰默认背景，太阳盘/天空渐变
; 都没有，太阳照不到的地方（看台内壁、车身底面）也会全黑。
; 天气视觉系统（gdext/weather_visuals.gd）会在此基础上按天气改天色/雾/雨。
environment/defaults/default_environment="res://game_environment.tres"

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
