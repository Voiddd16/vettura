[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
macos.debug = "res://vettura-godot/target/debug/libvettura_godot.dylib"
macos.release = "res://vettura-godot/target/release/libvettura_godot.dylib"
windows.debug.x86_64 = "res://vettura-godot/target/debug/vettura_godot.dll"
windows.release.x86_64 = "res://vettura-godot/target/release/vettura_godot.dll"
linux.debug.x86_64 = "res://vettura-godot/target/debug/libvettura_godot.so"
linux.release.x86_64 = "res://vettura-godot/target/release/libvettura_godot.so"
