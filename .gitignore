# Godot 4+ specific ignores
.godot/
/android/
export_presets.cfg

# 本地测试资源（车模、第三方工具）体积过大，不纳入版本库
# 参见 README.md 的「本地测试资源」章节
/test/

# FMOD 凭证与 SDK 缓存：账号、installer、so/dylib 均禁止入库
.fmod.env
.cache/
scripts/.venv/
scripts/__pycache__/

# Rust workspace 构建产物（workspace 根就是工程根）
/target/*
/dist/
*.dSYM/
CMakeCache.txt
CMakeFiles/
# `target/.gdignore` 必须入库：它让 Godot 跳过整个 target/，不导入构建产物
!/target/.gdignore

# vendored C++ 源码按需拉取（体积大），只跟踪说明文档。
# 拉取方式与版本记录在 third_party/README.md。
third_party/*
!third_party/README.md

# 本地 AI 技能安装器产物
.agents/
.claude/
skills-lock.json

# CodeGraph 本地索引（自带 .gitignore，目录整体忽略）
.codegraph/

# macOS / 编辑器杂项
.DS_Store
*.tmp
